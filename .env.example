# ==============================================================================
# PoD Engine — Production Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or configure these variables in your deployment dashboard,
# e.g., Vercel, Railway, Fly.io, Render, AWS, Docker).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Default Local SQLite:
DATABASE_URL="file:./dev.db"

# Remote LibSQL / Turso (Serverless Edge SQLite):
# DATABASE_URL="libsql://[your-database-name].turso.io"
# TURSO_AUTH_TOKEN="your-turso-database-auth-token"

# PostgreSQL (e.g. Supabase, Neon, AWS RDS, Prisma Postgres):
# Note: When migrating to PostgreSQL, update provider = "postgresql" in prisma/schema.prisma
# DATABASE_URL="postgresql://user:password@host:5432/pod_engine?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth.js v5 / Auth.js)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key using: `openssl rand -base64 32`
AUTH_SECRET="your-production-random-secret-openssl-rand-base64-32"
# Canonical URL of your application in production:
AUTH_URL="https://your-domain.com"
# Optional fallback alias:
NEXTAUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. STRIPE BILLING & PAYMENTS
# ------------------------------------------------------------------------------
# Live keys: sk_live_... / pk_live_... | Test keys: sk_test_... / pk_test_...
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret for verifying Stripe webhook events:
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional custom Stripe Price IDs for tiered subscriptions/sprints:
# STRIPE_PRICE_ID_SPRINT="price_..."
# STRIPE_PRICE_ID_SELF_SERVE="price_..."
# STRIPE_PRICE_ID_STUDIO="price_..."

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM GATEWAY
# ------------------------------------------------------------------------------
# OpenAI API Key (starts with sk-proj-... or sk-...)
OPENAI_API_KEY=""

# Default AI Model (e.g., gpt-4o-mini, gpt-4o, claude-3-5-sonnet, etc.)
OPENAI_MODEL="gpt-4o-mini"

# Optional custom OpenAI-compatible API base URL (OpenRouter, Groq, Together, Ollama)
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# Optional alternative direct provider keys:
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."

# ------------------------------------------------------------------------------
# 5. APPLICATION & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"