generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth — NextAuth.js (Auth.js)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  memberships WorkspaceMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  notifications Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Workspaces & Membership
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("trial")
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User?             @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]
  notifications Notification[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // owner | admin | member
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  type        String   @default("info")
  title       String
  message     String   @default("")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([read])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String   @default("")
  status      String   @default("active")
  podScore    Int      @default(0)
  confidence  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiments  Experiment[]
  landingPages LandingPage[]

  @@index([workspaceId])
}

model Experiment {
  id               String   @id
  projectId        String
  name             String
  status           String   @default("draft")
  budget           Int      @default(0)
  channel          String   @default("[]") // JSON array stored as string for SQLite
  startDate        DateTime?
  endDate          DateTime?
  traffic          Int      @default(0)
  conversions      Int      @default(0)
  conversionRate   Float    @default(0)
  highIntentActions Int     @default(0)
  highIntentRate   Float    @default(0)
  costPerAction    Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants      Variant[]
  leads         Lead[]
  signalEvents  SignalEvent[]
  insights      AIInsight[]
  landingPages  LandingPage[]

  @@index([projectId])
  @@index([status])
}

model Variant {
  id               String   @id
  experimentId     String
  name             String
  headline         String
  subheadline      String   @default("")
  positioning      String   @default("")
  cta              String   @default("")
  trafficAllocation Int     @default(0)
  visitors         Int      @default(0)
  conversions      Int      @default(0)
  conversionRate   Float    @default(0)
  highIntent       Int      @default(0)
  costPerAction    Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

model Lead {
  id                String   @id
  experimentId      String
  variantId         String
  name              String
  email             String
  company           String   @default("")
  role              String   @default("")
  source            String   @default("")
  intentScore       Int      @default(0)
  pricingInteraction Boolean @default(false)
  status            String   @default("new")
  events            String   @default("[]") // JSON array stored as string for SQLite
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([variantId])
  @@index([status])
}

model SignalEvent {
  id          String   @id
  experimentId String
  visitorId   String
  eventType   String
  variantId   String   @default("")
  metadata    String   @default("{}") // JSON object stored as string for SQLite
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([eventType])
  @@index([timestamp])
}

model AIInsight {
  id             String   @id
  experimentId   String
  type           String   // demand | audience | variant | pricing | recommendation
  title          String
  content        String
  confidence     Int      @default(0)
  recommendation String   @default("")
  evidence       String   @default("[]") // JSON array stored as string for SQLite
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([type])
}

model LandingPage {
  id             String   @id @default(cuid())
  projectId      String
  name           String
  template       String   @default("hero")
  headline       String
  subheadline    String
  cta            String
  positioning    String   @default("")
  status         String   @default("draft")
  experimentId   String?
  slug           String   @unique
  visitors       Int      @default(0)
  conversions    Int      @default(0)
  conversionRate Float    @default(0)
  bounceRate     Float    @default(0)
  avgTimeOnPage  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  experiment Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([experimentId])
  @@index([status])
  @@index([slug])
}
